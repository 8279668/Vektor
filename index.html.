            border-radius: 20px;
            background: white;
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 500;
            transition: 0.2s;
            color: #334155;
        }
        .toggle-btn:hover {
            background: #f1f5f9;
            border-color: #1a3b5d;
        }
        .toggle-btn.active {
            background: #1a3b5d;
            color: white;
            border-color: #1a3b5d;
        }

        .table-wrap {
            overflow-x: auto;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
        }
        table {
