            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 15px;
            padding: 12px;
            background: #f8fafc;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            align-items: center;
        }
        .column-toggle-group .label {
            font-weight: 600;
            color: #1a3b5d;
            margin-right: 10px;
            font-size: 0.9rem;
        }
        .toggle-btn {
            padding: 6px 16px;
