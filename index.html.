            margin-bottom: 20px;
            font-size: 0.95rem;
        }
        
        /* Ссылки в шапке */
        .header-links {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin: 10px 0 15px 0;
            padding: 8px 0;
            border-bottom: 1px solid #e9edf4;
        }
        .header-links a {
            color: #1a3b5d;
            text-decoration: none;
            font-weight: 500;
            font-size: 0.95rem;
            padding: 4px 8px;
            border-radius: 4px;
            transition: 0.2s;
        }
        .header-links a:hover {
            background: #f0f5ff;
            text-decoration: underline;
        }
        .header-links .divider {
            color: #cbd5e1;
            font-weight: 300;
        }

        .search-box { margin-bottom: 15px; }
        .search-input {
            width: 100%;
            padding: 10px 16px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 14px;
        }
        .search-input:focus {
