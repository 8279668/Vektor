        </div>

        <div class="search-box">
            <input type="text" id="searchInput" class="search-input" placeholder="🔍 Быстрый поиск по названию модели..." oninput="filterCatalog()" />
        </div>

        <div class="column-toggle-group">
            <span class="label">📋 Показать:</span>
            <button class="toggle-btn active" id="toggleDimensions" onclick="toggleColumns('dimensions')">📐 Габариты</button>
            <button class="toggle-btn active" id="toggleSpecs" onclick="toggleColumns('specs')">⚡ Характеристики</button>
            <span style="font-size:0.8rem; color:#64748b; margin-left:auto;">(нажмите, чтобы скрыть/показать)</span>
        </div>

        <div class="table-wrap">
            <table>
                <thead id="table-header">
                    <!-- Заголовок будет собран в JavaScript -->
                </thead>
                <tbody id="catalog-body"></tbody>
            </table>
        </div>

        <div class="order-section">
            <h3>📩 Оформление заказа</h3>
            <div class="actions">
                <input type="text" id="clientCompany" placeholder="Название компании *" />
                <input type="tel" id="clientPhone" placeholder="+7 (___) ___-__-__" maxlength="18" />
                <input type="text" id="clientName" placeholder="Контактное лицо (необязательно)" />
            </div>
            <div class="actions">
                <input type="email" id="clientEmail" placeholder="Email (для счета и копии)" />
                <textarea id="clientComment" rows="2" placeholder="Комментарий к заказу (адрес доставки, особые пожелания)"></textarea>
            </div>
            <div class="checkbox-group">
                <input type="checkbox" id="sendCopy" onchange="toggleEmailRequired()" />
                <label for="sendCopy">📧 Отправить копию заказа на этот email</label>
                <span class="email-required-hint" id="emailRequiredHint">* обязательно</span>
            </div>
            <div class="btn-group">
                <button class="btn btn-submit" onclick="sendOrder()">📨 Оформить заказ</button>
                <button class="btn btn-round" onclick="roundToPacks()">🔄 Округлить до упаковок</button>
                <button class="btn btn-update" onclick="refreshStocks()">🔄 Обновить остатки</button>
                <button class="btn btn-clear" onclick="clearAll()">🗑️ Очистить все</button>
            </div>
            <div style="margin-top: 12px; font-size: 0.85em; color: #64748b;">
                <span class="required">*</span> — поля обязательные для заполнения
            </div>
        </div>

        <div class="footer-note">
            ⚡ Цены указаны с НДС 22%. Для оформления заказа нажмите "Оформить заказ".
        </div>
    </div>

